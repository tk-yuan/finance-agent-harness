# 复制为 .env 并填入自己的 key

# 检索用的向量（硅基流动）
SILICONFLOW_API_KEY=sk-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Agent 的推理模型
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
HARNESS_MODEL=deepseek-chat
HARNESS_SUBAGENT_MODEL=deepseek-chat

# 运行时约束（可选，不填用默认值）
# 一次完整的「查账 → 定科目 → 审核 → 报表」实测要 20~35 轮，40 留了余量
HARNESS_MAX_TURNS=40
HARNESS_SUBAGENT_TURNS=8
HARNESS_CTX_BUDGET=60000
HARNESS_TOOL_INLINE=2000

# 财务域（可选）
# FIN_DB_PATH 不填就用项目内的 data/finance.db，克隆下来零配置即可跑
FIN_CASHIER=出纳-张三
FIN_ACCOUNTANT=会计-李四
FIN_FISCAL_YEAR=2026
